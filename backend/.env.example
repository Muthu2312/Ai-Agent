# Application
PROJECT_NAME="Multi-Agent Document Intelligence Platform"
ENVIRONMENT="development"
DEBUG=true

# Security & Authentication (JWT + httpOnly cookies)
SECRET_KEY="super-secret-development-key-change-in-production-random-bytes"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false

# PostgreSQL + pgvector Database
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=doc_intelligence
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/doc_intelligence

# Free-Source Embeddings (runs on local CPU, 0 cost, 0 API key)
EMBEDDING_PROVIDER=fastembed
FASTEMBED_MODEL=BAAI/bge-small-en-v1.5
VECTOR_DIMENSION=384

# Free-Source LLM Provider ("groq" or "ollama" or "openai")
LLM_PROVIDER=groq
GROQ_API_KEY=your_free_groq_api_key_from_console_groq_com
GROQ_MODEL=llama-3.3-70b-versatile

# Local Ollama Free Source
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text

# Optional OpenAI
OPENAI_API_KEY=""

# LangSmith Observability
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
LANGCHAIN_API_KEY=""
LANGCHAIN_PROJECT="document-intelligence-platform"
