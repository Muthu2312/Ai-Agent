# ==========================================
# MULTI-AGENT DOCUMENT INTELLIGENCE PLATFORM
# Environment Variables Configuration
# ==========================================

# Application
PROJECT_NAME="Multi-Agent Document Intelligence Platform"
ENVIRONMENT="development"
DEBUG=true

# Security & Authentication (JWT + httpOnly cookies)
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false

# PostgreSQL + pgvector Database
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=doc_intelligence
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/doc_intelligence

# Optional MongoDB Connection
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=doc_intelligence
PRIMARY_DB_TYPE=postgresql

# LLM Providers (OpenAI or Local Ollama / Free Source)
LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
VECTOR_DIMENSION=1536

# Local Ollama Fallback Settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
OLLAMA_EMBED_MODEL=nomic-embed-text

# LangSmith Observability
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=document-intelligence-platform
